{
  "name": "bsp_modeler",
  "version": "0.1.0",
  "private": true,
  "description": "BSP model generator: assemble geometry from grid blocks and texture per face; the server compiles the BSP with the qbsp/light/vis toolchain",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "prod": "vite build && node server/index.js --prod",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-textures": "node scripts/gen-textures.mjs"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
