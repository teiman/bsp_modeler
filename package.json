{
  "name": "bsp_modeler",
  "version": "0.1.0",
  "private": true,
  "description": "Generador de modelos en formato BSP: ensambla geometria con bloques en grid y texturiza por face; el servidor compila el BSP con el toolchain qbsp/light/vis",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "prod": "vite build && node server/index.js --prod",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-textures": "node scripts/gen-textures.mjs"
  },
  "dependencies": {
    "pngjs": "^7.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
